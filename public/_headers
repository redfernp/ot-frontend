# Affiliate cloak pages get an extra layer of crawler protection on top of
# the per-page noindex meta tag they already render. Robots.txt also
# disallows the redirect paths, but defence in depth is cheap.
/go/*
  X-Robots-Tag: noindex, nofollow

/es/go/*
  X-Robots-Tag: noindex, nofollow

/_gone/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300
