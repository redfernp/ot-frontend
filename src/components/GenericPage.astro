---
import type { WpPost } from "@/lib/graphql";
import { rewriteCmsHtml } from "@/lib/cmsContent";
import JsonLd from "@/components/JsonLd.astro";
import { breadcrumbNode } from "@/lib/schema";
import StrongTipsBand from "@/components/StrongTipsBand.astro";
import { BEST_BETS_HUB, BEST_BETS_LIST_ID, STRONG_TIP_PAGES } from "@/lib/strongTips";

type Props = {
  page: WpPost;
};

const { page } = Astro.props;
const segments = (page.uri || "")
  .replace(/^\/+|\/+$/g, "")
  .split("/")
  .filter(Boolean);

let path = "";
const breadcrumbs = [
  { label: "Home", href: "/" },
  ...segments.map((segment, index) => {
    path += `/${segment}`;
    const label = segment
      .replace(/-/g, " ")
      .replace(/\b\w/g, (letter) => letter.toUpperCase());

    return {
      label,
      href: index === segments.length - 1 ? undefined : `${path}/`,
    };
  }),
];

const modified = page.modified
  ? new Date(page.modified).toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" })
  : null;
const pageContent = rewriteCmsHtml(page.content || "<p>This page is being updated.</p>");

// The Best Bets hub: the plugin's intro, then buttons to each market page and
// the top pick per market, then its 1X2 list. Splits at the plugin's marker.
const MARKER = "<!-- oddstips-strong-tips:start -->";
const isHub = page.uri === BEST_BETS_HUB && pageContent.includes(MARKER);
const [hubIntro, hubRest] = isHub
  ? [pageContent.slice(0, pageContent.indexOf(MARKER)), pageContent.slice(pageContent.indexOf(MARKER))]
  : ["", ""];
const marketButtons = STRONG_TIP_PAGES.filter((p) => p.href !== BEST_BETS_HUB);
---

<JsonLd nodes={[breadcrumbNode(breadcrumbs, Astro.url.pathname)]} />

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {breadcrumbs.map((crumb, i) => (
    <>
      {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
      {i < breadcrumbs.length - 1 && <span class="sep">/</span>}
    </>
  ))}
</nav>

<article class="generic-page">
  <header class="page-header">
    <h1>{page.title || "Oddstips"}</h1>
    {modified && <p>Last updated {modified}</p>}
  </header>

  {isHub ? (
    <>
      <section class="page-content" set:html={hubIntro} />

      <nav class="market-buttons" aria-label="Best bets by market">
        {marketButtons.map((p) => <a href={p.href}>{p.label}</a>)}
      </nav>

      <StrongTipsBand heading="Today's Top Pick in Every Market" eyebrow="Best bets by market" tone="light" hub />

      <section class="page-content" aria-labelledby={BEST_BETS_LIST_ID}>
        <h2 id={BEST_BETS_LIST_ID}>Best Match Result Bets Today</h2>
        <Fragment set:html={hubRest} />
      </section>
    </>
  ) : (
    <section class="page-content" set:html={pageContent} />
  )}
</article>

<style>
  .breadcrumbs {
    color: var(--ot-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .breadcrumbs a { color: var(--ot-brand-blue); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .sep { color: var(--ot-muted-2); margin: 0 0.35rem; }

  .generic-page {
    display: grid;
    gap: 1.25rem;
    margin: 0 auto;
    max-width: 900px;
  }

  .page-header {
    border-bottom: 1px solid var(--ot-border);
    padding-bottom: 1rem;
  }
  .page-header h1 {
    color: var(--ot-text);
    font-size: clamp(1.85rem, 4vw, 2.55rem);
    margin: 0;
  }
  .page-header p {
    color: var(--ot-muted);
    font-size: 0.92rem;
    margin: 0.55rem 0 0;
  }

  .page-content {
    background: var(--ot-surface);
    border: 1px solid var(--ot-border);
    border-radius: var(--ot-radius);
    box-shadow: var(--ot-shadow-sm);
    color: var(--ot-text-2);
    font-size: 1rem;
    line-height: 1.75;
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .page-content :global(*) { max-width: 100%; }
  .page-content > h2 {
    border-bottom: 2px solid var(--ot-brand-blue-soft);
    color: var(--ot-brand-blue-dark);
    font-size: 1.35rem;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    padding-bottom: 0.35rem;
  }
  .generic-page :global(.strong-band) { margin: 0; }

  .market-buttons {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr));
  }
  .market-buttons a {
    background: var(--ot-ink);
    border-radius: 999px;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 0.75rem 0.8rem;
    text-align: center;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .market-buttons a:hover { background: var(--ot-ink-2); color: var(--ot-gold); }
  .page-content :global(h1),
  .page-content :global(h2),
  .page-content :global(h3),
  .page-content :global(h4) {
    color: var(--ot-text);
    line-height: 1.25;
    margin: 1.65rem 0 0.75rem;
  }
  .page-content :global(h1:first-child),
  .page-content :global(h2:first-child),
  .page-content :global(h3:first-child) {
    margin-top: 0;
  }
  .page-content :global(h2) {
    border-bottom: 2px solid var(--ot-brand-blue-soft);
    color: var(--ot-brand-blue-dark);
    font-size: 1.35rem;
    padding-bottom: 0.35rem;
  }
  .page-content :global(h3) { font-size: 1.15rem; }
  .page-content :global(p) { margin: 0 0 1rem; }
  .page-content :global(a) {
    color: var(--ot-brand-blue);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ot-brand-blue-soft);
    text-underline-offset: 3px;
  }
  .page-content :global(a:hover) {
    color: var(--ot-brand-blue-dark);
    text-decoration-color: var(--ot-brand-blue);
  }
  .page-content :global(ul),
  .page-content :global(ol) {
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
  }
  .page-content :global(li) { margin-bottom: 0.35rem; }
  .page-content :global(strong) { color: var(--ot-text); }
  .page-content :global(img) {
    border-radius: var(--ot-radius-sm);
    display: block;
    height: auto;
    max-width: 100%;
  }
  .page-content :global(table) {
    border-collapse: collapse;
    display: block;
    margin: 1.25rem 0;
    overflow-x: auto;
    width: 100%;
  }
  .page-content :global(th),
  .page-content :global(td) {
    border: 1px solid var(--ot-border);
    padding: 0.65rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .page-content :global(th) {
    background: var(--ot-surface-2);
    color: var(--ot-text);
    font-weight: 800;
  }

  /* Strong tips pages (football-*-tips), generated by the paul365 plugin's
     StrongTips.php between oddstips-strong-tips markers. */
  .page-content :global(.ot-strong__date) { color: var(--ot-text-2); font-size: 0.9rem; }
  .page-content :global(.ot-strong__table table) { display: table; min-width: 640px; }
  .page-content :global(.ot-strong__table) { overflow-x: auto; }
  .page-content :global(.ot-strong__row td) { vertical-align: middle; }
  .page-content :global(.ot-strong__ko) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .page-content :global(.ot-strong__fixture small),
  .page-content :global(.ot-strong__pick small),
  .page-content :global(.ot-acca small) {
    color: var(--ot-text-2);
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .page-content :global(.ot-strong__row--odds .ot-strong__pick small) { color: var(--ot-muted); }
  .page-content :global(.ot-strong__row--stats .ot-strong__pick small) { color: var(--ot-green); font-weight: 700; }
  .page-content :global(.ot-strong__odds) { font-variant-numeric: tabular-nums; font-weight: 800; }
  .page-content :global(.ot-strong__cta a) {
    background: var(--ot-gold);
    border-radius: 999px;
    color: var(--ot-ink);
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.45rem 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .page-content :global(.ot-strong__cta a:hover) { background: #e7bc60; color: var(--ot-ink); }
  .page-content :global(.ot-strong__empty) {
    background: var(--ot-surface-2);
    border-radius: var(--ot-radius-sm);
    padding: 0.9rem 1rem;
  }
  .page-content :global(.ot-strong__legend) { color: var(--ot-text-2); font-size: 0.85rem; margin-top: 1rem; }

  .page-content :global(.ot-power) { align-items: center; display: inline-flex; gap: 0.5rem; min-width: 120px; }
  .page-content :global(.ot-power__track) {
    background: var(--ot-border);
    border-radius: 999px;
    display: block;
    flex: 1;
    height: 0.55rem;
    overflow: hidden;
  }
  .page-content :global(.ot-power__fill) { border-radius: 999px; display: block; height: 100%; }
  .page-content :global(.ot-power--high .ot-power__fill) { background: var(--ot-green); }
  .page-content :global(.ot-power--mid .ot-power__fill) { background: var(--ot-gold); }
  .page-content :global(.ot-power--low .ot-power__fill) { background: var(--ot-muted); }
  .page-content :global(.ot-power__num) { font-variant-numeric: tabular-nums; font-weight: 800; min-width: 1.8rem; }

  .page-content :global(.ot-acca__card) {
    border: 1px solid var(--ot-border);
    border-radius: var(--ot-radius-sm);
    margin: 0.75rem 0 1.5rem;
    padding: 1rem;
  }
  .page-content :global(.ot-acca__legs) { margin-bottom: 0.75rem; }
  .page-content :global(.ot-acca__legs li) {
    align-items: center;
    border-bottom: 1px solid var(--ot-border);
    display: grid;
    gap: 0.35rem 1rem;
    grid-template-columns: 1fr auto auto;
    padding: 0.6rem 0;
  }
  .page-content :global(.ot-acca__total) { font-size: 1.05rem; }

  .page-content :global(.ot-strong__history-title) { margin-top: 2rem; }
  .page-content :global(.ot-strong__history) {
    border: 1px solid var(--ot-border);
    border-radius: var(--ot-radius-sm);
    margin: 0.5rem 0;
    padding: 0 1rem;
  }
  .page-content :global(.ot-strong__history summary) {
    cursor: pointer;
    font-weight: 800;
    padding: 0.85rem 0;
  }
  .page-content :global(.ot-strong__history[open]) { padding-bottom: 0.75rem; }

  @media (max-width: 640px) {
    .page-content :global(.ot-acca__legs li) { grid-template-columns: 1fr auto; }
    .page-content :global(.ot-acca__legs li .ot-power) { grid-column: 1 / -1; }
  }
</style>
