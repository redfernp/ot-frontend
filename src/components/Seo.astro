---
import type { SeoFields } from "@/lib/graphql";
import { rewriteCmsLink, publicSiteOrigin } from "@/lib/cmsContent";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  seo?: SeoFields;
  noindex?: boolean;
};

// Default to indexable for go-live. Pages can opt into noindex either by:
//   - Passing noindex={true} as a prop (used by /go/{slug}/ affiliate cloaks
//     which also set their own robots meta directly), or
//   - Yoast marking the underlying post/page/category as noindex (resolved by
//     the snapshot plugin into seo.noindex).
const { title, description, canonical, seo, noindex = false } = Astro.props;
const pageTitle = seo?.title || title || "Oddstips";
const pageDescription = seo?.metaDesc || description;

// Combined indexability flag. Either source wins.
const isNoindex = noindex || Boolean(seo?.noindex);

// Canonical resolution order:
//   1. Yoast's canonical from the snapshot (after rewriting CMS origin to the
//      public site origin)
//   2. An explicit canonical prop passed by the page
//   3. Self-referencing fallback derived from the public origin + current path.
//      Indexable pages must always have a canonical; missing tags get
//      flagged by every SEO crawler. Noindex pages skip the fallback to
//      avoid sending Google a contradictory "don't index but here's the
//      canonical to use if you do" signal.
const yoastCanonical = rewriteCmsLink(seo?.canonical || canonical);
const selfCanonical = `${publicSiteOrigin()}${Astro.url.pathname}`;
const canonicalUrl = yoastCanonical || (isNoindex ? undefined : selfCanonical);

const ogImage = rewriteCmsLink(seo?.opengraphImage?.sourceUrl);
---

<title>{pageTitle}</title>
{pageDescription && <meta name="description" content={pageDescription} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{isNoindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:title" content={seo?.opengraphTitle || pageTitle} />
{(seo?.opengraphDescription || pageDescription) && (
  <meta property="og:description" content={seo?.opengraphDescription || pageDescription} />
)}
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={seo?.opengraphImage?.sourceUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={seo?.twitterTitle || seo?.opengraphTitle || pageTitle} />
{(seo?.twitterDescription || seo?.opengraphDescription || pageDescription) && (
  <meta name="twitter:description" content={seo?.twitterDescription || seo?.opengraphDescription || pageDescription} />
)}
