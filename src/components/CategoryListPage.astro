---
// {category}/page/N/: the rest of a category's upcoming tips, for crawlers and
// visitors without JavaScript. With JS, the category page's "Load more tips"
// button appends these rows in place instead of navigating here.
//
// Rendered inside a noindex BaseLayout with no canonical (see [...path].astro).
import UpcomingTipList from "@/components/UpcomingTipList.astro";
import DateJumpRail from "@/components/DateJumpRail.astro";
import type { WpCategory } from "@/lib/graphql";
import { type TipList, jumpRailLinks } from "@/lib/tipLists";

type Props = {
  category: WpCategory;
  list: TipList;
  page: number;
};

const { category, list, page } = Astro.props;
const name = category.name || "Category";
const baseUri = category.uri || "/";
const railLinks = jumpRailLinks(list, baseUri, page);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <a href={baseUri}>{name}</a>
  <span class="sep">/</span>
  <span aria-current="page">Page {page}</span>
</nav>

<h1 class="page-title">{name} Betting Tips: Page {page}</h1>

<div class="list-stack">
  {list.mode === "upcoming" && <DateJumpRail links={railLinks} />}
  <UpcomingTipList
    list={list}
    baseUri={baseUri}
    page={page}
    eyebrow="Upcoming predictions"
    heading={`${name} tips`}
    headingId="latest-heading"
    emptyText="No current tips are available for this competition."
  />
</div>

<style>
  .breadcrumbs { color: var(--ot-muted); font-size: 0.85rem; margin-bottom: 1rem; }
  .breadcrumbs a { color: var(--ot-brand-blue); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .sep { color: var(--ot-muted-2); margin: 0 0.35rem; }
  .page-title { font-size: clamp(1.5rem, 3vw, 2.1rem); margin-bottom: 1.25rem; }
  .list-stack { display: grid; gap: 1.25rem; }
</style>
