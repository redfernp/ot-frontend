---
import CategorySidebar from "@/components/CategorySidebar.astro";
import DateRail from "@/components/DateRail.astro";
import FootballDirectory from "@/components/FootballDirectory.astro";
import HubHero from "@/components/HubHero.astro";
import LeagueTipList from "@/components/LeagueTipList.astro";
import OfferBanner from "@/components/OfferBanner.astro";
import TipListSection from "@/components/TipListSection.astro";
import type { WpCategory, WpPost } from "@/lib/graphql";
import { placeholderInternationalTips, placeholderRelatedTips } from "@/lib/relatedTips";
import { getCategorySeoCopy } from "@/lib/categorySeoCopy";
import { rewriteCmsHtml } from "@/lib/cmsContent";
import JsonLd from "@/components/JsonLd.astro";
import { breadcrumbNode, collectionPageNode } from "@/lib/schema";
import {
  PAGE_SIZE,
  RAIL_DAYS_AFTER,
  RAIL_DAYS_BEFORE,
  getLeagueTipsForDate,
  getUpcomingInternationals,
  londonTodayIso,
  railDates,
} from "@/lib/footballHub";

// Reads ACF Pro fields category_top_seo_text + category_bottom_seo_text from WP.
// Falls back to src/lib/categorySeoCopy for dev preview / unpopulated categories.
type CategoryWithSeo = WpCategory & {
  posts?: { nodes: WpPost[] };
  categoryTopSeoText?: {
    categoryTopSeoText?: string;
  };
  categoryBottomSeoText?: {
    categoryBottomSeoText?: string;
  };
};

type Props = {
  category: CategoryWithSeo;
};

const { category } = Astro.props;
import { WPGRAPHQL_ENDPOINT } from "astro:env/server";
const hasWpGraphQL = Boolean(WPGRAPHQL_ENDPOINT);

const fallbackSeo = getCategorySeoCopy(category.slug);
// ACF-authored SEO HTML may contain editor-inserted links pointing at the
// Cloudways host (WordPress's home URL); rewrite them to the public origin
// before set:html so they don't leak the CMS host into the live page.
const topSeo = rewriteCmsHtml(
  category.categoryTopSeoText?.categoryTopSeoText || fallbackSeo.top || "",
);
const bottomSeo = rewriteCmsHtml(
  category.categoryBottomSeoText?.categoryBottomSeoText || fallbackSeo.bottom || "",
);

const categoryName = category.name || "Football";

// Page order (top to bottom), identical with and without JavaScript:
//   1. H1 + top SEO copy in the hero
//   2. Featured bookmaker offer
//   3. Date rail
//   4. Every upcoming international in the rail window
//   5. Today's league tips, top PAGE_SIZE, then /football/page/N/
//   6. Bottom SEO copy
//   7. Search and league links (formerly the sidebar), then the country directory
const today = londonTodayIso();
const liveLeagueTips = await getLeagueTipsForDate(today).catch(() => []);
const leagueTips = liveLeagueTips.length || hasWpGraphQL ? liveLeagueTips : placeholderRelatedTips;

const liveInternational = await getUpcomingInternationals().catch(() => []);
const internationalPosts = liveInternational.length || hasWpGraphQL
  ? liveInternational
  : placeholderInternationalTips;

// Rail dates that have league tips, so empty days show as empty without the
// browser needing every day's rows up front.
const availableDates = (
  await Promise.all(
    railDates(today).map(async (date) =>
      (await getLeagueTipsForDate(date).catch(() => [])).length ? date : null,
    ),
  )
).filter((date): date is string => Boolean(date));

const defaultLede =
  "<p>Looking for today's best Football 1x2 betting tips and predictions? Oddstips covers every major league, cup and international fixture with odds, value angles and accumulator picks. Browse the latest predictions below.</p>";
// The top SEO field is the hero intro: short and entity-rich, so the tips
// start high on the page. Longer guide copy belongs in the bottom field.
const heroLede = topSeo || category.description || defaultLede;

const schemaNodes = [
  breadcrumbNode([{ label: "Home", href: "/" }, { label: categoryName }], Astro.url.pathname),
  collectionPageNode({
    name: `${categoryName} 1x2 Betting Tips & Predictions`,
    path: Astro.url.pathname,
    // Exactly the tips visible in the HTML, in page order.
    posts: [...internationalPosts, ...leagueTips.slice(0, PAGE_SIZE)],
    sportName: "Football",
    upcomingOnly: false,
    limit: internationalPosts.length + PAGE_SIZE,
  }),
];
---

<JsonLd nodes={schemaNodes} />

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span aria-current="page">{categoryName}</span>
</nav>

<HubHero
  eyebrow="Football 1x2 betting"
  heading={`${categoryName} 1x2 Betting Tips & Predictions`}
  ledeHtml={heroLede}
/>

<div class="hub-main">
  <OfferBanner />

  <DateRail
    daysBefore={RAIL_DAYS_BEFORE}
    daysAfter={RAIL_DAYS_AFTER}
    availableDates={availableDates}
  />

  {internationalPosts.length > 0 && (
    <TipListSection
      posts={internationalPosts}
      eyebrow="International"
      eyebrowAccent="orange"
      heading="Top International Matches"
      headingId="internationals-heading"
      unit={{ singular: "match", plural: "matches" }}
      emptyText="No international matches in the next week."
      featured
      groupByDate
      dateFilter={false}
    />
  )}

  <LeagueTipList
    posts={leagueTips}
    date={today}
    heading="Today's Football Betting Predictions"
    headingId="latest-football-heading"
  />

  {bottomSeo && (
    <section class="seo-content" aria-label="Category guide">
      <div class="seo-prose" set:html={bottomSeo} />
    </section>
  )}

  <div class="hub-links">
    <CategorySidebar currentPath={category.uri} showOffer={false} />
  </div>

  <FootballDirectory />
</div>


<style>
  .breadcrumbs {
    color: var(--ot-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .breadcrumbs a { color: var(--ot-brand-blue); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .sep { color: var(--ot-muted-2); margin: 0 0.35rem; }

  /* Former sidebar, now a full-width band below the guide copy: search on
     its own row, then the link lists side by side. */
  .hub-links :global(.cat-sidebar) {
    align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .hub-links :global(.sidebar-search),
  .hub-links :global(.sidebar-be) {
    grid-column: 1 / -1;
  }
  .hub-links :global(.sidebar-search) {
    max-width: 560px;
  }

  .hub-main {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
    /* Grid column gives us minmax(0, 1fr) but a flex column container with
       wide intrinsic content (DateRail's 3290px-wide scrollable list) blows
       past the column allocation. width: 100% pins us to the column width. */
    width: 100%;
  }

  /* SEO CONTENT */
  .seo-content {
    background: var(--ot-surface);
    border: 1px solid var(--ot-border);
    border-radius: var(--ot-radius);
    box-shadow: var(--ot-shadow-sm);
    padding: 1.75rem 1.75rem 2rem;
  }
  .seo-prose {
    color: var(--ot-text);
    font-size: 1rem;
    line-height: 1.7;
    max-width: none;
  }
  .seo-prose :global(h2) {
    border-bottom: 2px solid var(--ot-brand-blue-soft);
    color: var(--ot-brand-blue-dark);
    font-size: 1.25rem;
    margin: 2rem 0 0.85rem;
    padding-bottom: 0.4rem;
  }
  .seo-prose :global(h2:first-child) { margin-top: 0; }
  .seo-prose :global(h3) {
    color: var(--ot-brand-blue-dark);
    font-size: 1.1rem;
    margin: 1.5rem 0 0.6rem;
  }
  .seo-prose :global(p) {
    color: var(--ot-text-2);
    margin: 0 0 1rem;
  }
  .seo-prose :global(strong) { color: var(--ot-text); }
  .seo-prose :global(a) {
    color: var(--ot-brand-blue);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ot-brand-blue-soft);
    text-underline-offset: 3px;
  }
  .seo-prose :global(a:hover) {
    color: var(--ot-brand-blue-dark);
    text-decoration-color: var(--ot-brand-blue);
  }
  .seo-prose :global(ul),
  .seo-prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .seo-prose :global(ul) { list-style: none; padding-left: 0; }
  .seo-prose :global(ul li) {
    color: var(--ot-text-2);
    padding: 0.2rem 0 0.2rem 1.6rem;
    position: relative;
  }
  .seo-prose :global(ul li)::before {
    background: var(--ot-brand-orange);
    border-radius: 999px;
    content: "";
    height: 7px;
    left: 0.3rem;
    position: absolute;
    top: 0.85rem;
    width: 7px;
  }
  .seo-prose :global(ol) {
    counter-reset: seo-counter;
    list-style: none;
    padding-left: 0;
  }
  .seo-prose :global(ol li) {
    color: var(--ot-text-2);
    counter-increment: seo-counter;
    padding: 0.4rem 0 0.4rem 2.2rem;
    position: relative;
  }
  .seo-prose :global(ol li)::before {
    background: var(--ot-brand-blue);
    border-radius: 6px;
    color: #fff;
    content: counter(seo-counter);
    font-size: 0.78rem;
    font-weight: 900;
    height: 22px;
    left: 0;
    line-height: 22px;
    position: absolute;
    text-align: center;
    top: 0.45rem;
    width: 22px;
  }

  @media (max-width: 880px) {
    .hub-layout { grid-template-columns: 1fr; }
    .seo-content { padding: 1.5rem 1.4rem; }
  }
</style>
