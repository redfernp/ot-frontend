---
type Props = {
  label?: string;
  daysBefore?: number;
  daysAfter?: number;
};

const {
  label = "Match date selector",
  daysBefore = 28,
  daysAfter = 6,
} = Astro.props;

function londonTodayIso() {
  const parts = new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "2-digit",
    timeZone: "Europe/London",
    year: "numeric",
  }).formatToParts(new Date());
  const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));

  return `${values.year}-${values.month}-${values.day}`;
}

function addDays(isoDate: string, offset: number) {
  const [year, month, day] = isoDate.split("-").map(Number);
  const date = new Date(Date.UTC(year, month - 1, day + offset));
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, "0");
  const d = String(date.getUTCDate()).padStart(2, "0");

  return `${y}-${m}-${d}`;
}

function dateLabel(isoDate: string, offset: number) {
  if (offset === -1) {
    return "Yesterday";
  }

  if (offset === 0) {
    return "Today";
  }

  if (offset === 1) {
    return "Tomorrow";
  }

  return new Intl.DateTimeFormat("en-GB", {
    timeZone: "UTC",
    weekday: "short",
  }).format(new Date(`${isoDate}T00:00:00Z`));
}

function shortDate(isoDate: string) {
  return new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    timeZone: "UTC",
  }).format(new Date(`${isoDate}T00:00:00Z`));
}

const today = londonTodayIso();
const items = Array.from({ length: daysBefore + daysAfter + 1 }, (_, index) => {
  const offset = index - daysBefore;
  const isoDate = addDays(today, offset);

  return {
    offset,
    isoDate,
    label: dateLabel(isoDate, offset),
    caption: shortDate(isoDate),
  };
});
---

<nav
  class="date-rail"
  aria-label={label}
  data-date-rail
  data-days-before={daysBefore}
  data-days-after={daysAfter}
>
  <div class="date-list">
    {items.map((item) => (
      <button
        type="button"
        class:list={["date-item", { active: item.offset === 0 }]}
        data-date-link
        data-date-offset={item.offset}
        data-date={item.isoDate}
        aria-current={item.offset === 0 ? "date" : undefined}
      >
        <strong>{item.label}</strong>
        <span>{item.caption}</span>
      </button>
    ))}
  </div>
</nav>

<script is:inline>
  (() => {
    const scriptVersion = "date-filter-v4";

    if (window.__otDateRailReady === scriptVersion) {
      return;
    }

    window.__otDateRailReady = scriptVersion;

    const isoPattern = /^\d{4}-\d{2}-\d{2}$/;

    function londonTodayIso() {
      const parts = new Intl.DateTimeFormat("en-GB", {
        day: "2-digit",
        month: "2-digit",
        timeZone: "Europe/London",
        year: "numeric",
      }).formatToParts(new Date());
      const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));

      return `${values.year}-${values.month}-${values.day}`;
    }

    function addDays(isoDate, offset) {
      const [year, month, day] = isoDate.split("-").map(Number);
      const date = new Date(Date.UTC(year, month - 1, day + offset));
      const y = date.getUTCFullYear();
      const m = String(date.getUTCMonth() + 1).padStart(2, "0");
      const d = String(date.getUTCDate()).padStart(2, "0");

      return `${y}-${m}-${d}`;
    }

    function labelFor(isoDate, offset) {
      if (offset === -1) {
        return "Yesterday";
      }

      if (offset === 0) {
        return "Today";
      }

      if (offset === 1) {
        return "Tomorrow";
      }

      return new Intl.DateTimeFormat("en-GB", {
        timeZone: "UTC",
        weekday: "short",
      }).format(new Date(`${isoDate}T00:00:00Z`));
    }

    function shortDate(isoDate) {
      return new Intl.DateTimeFormat("en-GB", {
        day: "2-digit",
        month: "short",
        timeZone: "UTC",
      }).format(new Date(`${isoDate}T00:00:00Z`));
    }

    function queryDate() {
      const url = new URL(window.location.href);
      const value = url.searchParams.get("date");

      return value && isoPattern.test(value) ? value : null;
    }

    function syncDateQuery(activeDate) {
      const url = new URL(window.location.href);
      url.searchParams.set("date", activeDate);
      window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    }

    function availableDates() {
      const rows = Array.from(document.querySelectorAll("[data-date-filter-section] [data-tip-date]"));

      return new Set(
        rows
          .map((row) => row.dataset.tipDate)
          .filter((date) => date && isoPattern.test(date))
      );
    }

    function updateRails(activeDate, available) {
      const today = londonTodayIso();
      const hasAvailability = available.size > 0;

      document.querySelectorAll("[data-date-rail]").forEach((rail) => {
        rail.querySelectorAll("[data-date-link]").forEach((link) => {
          const offset = Number(link.dataset.dateOffset || 0);
          const isoDate = addDays(today, offset);
          const hasTips = !hasAvailability || available.has(isoDate);

          link.dataset.date = isoDate;
          link.classList.toggle("active", isoDate === activeDate);
          link.classList.toggle("is-empty", !hasTips);
          link.title = hasTips ? "" : "No tips currently loaded for this date";

          if (isoDate === activeDate) {
            link.setAttribute("aria-current", "date");
          } else {
            link.removeAttribute("aria-current");
          }

          const mainLabel = link.querySelector("strong");
          const subLabel = link.querySelector("span");

          if (mainLabel) {
            mainLabel.textContent = labelFor(isoDate, offset);
          }

          if (subLabel) {
            subLabel.textContent = shortDate(isoDate);
          }
        });
      });
    }

    function revealActiveDate() {
      document.querySelectorAll("[data-date-rail]").forEach((rail) => {
        const active = rail.querySelector("[data-date-link].active");

        if (!active) {
          return;
        }

        active.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      });
    }

    function setCountText(count, visible) {
      if (!count) return;
      const singular = count.dataset.singular || "tip";
      const plural = count.dataset.plural || "tips";
      count.textContent = `${visible} ${visible === 1 ? singular : plural}`;
    }

    function formatDateHeader(isoDate) {
      try {
        return new Intl.DateTimeFormat("en-GB", {
          weekday: "long",
          day: "numeric",
          month: "long",
          timeZone: "UTC",
        }).format(new Date(`${isoDate}T00:00:00Z`));
      } catch {
        return isoDate;
      }
    }

    // Filter rule for grouped sections, in priority order:
    //   1. Active date has tips → show only that date's group. Hide placeholder.
    //      Past, future and placeholder all hidden. Each rail click lands on
    //      exactly that date's tips.
    //   2. Active date empty AND active === today AND future groups exist →
    //      placeholder visible + every future group. Message: "Browse
    //      upcoming fixtures below."
    //   3. Active date empty AND active === today AND no future groups but
    //      past groups exist → placeholder visible + most recent past group
    //      only. Message: "Showing the most recent past tips below." This is
    //      the SEO fallback: Google would otherwise see a blank category and
    //      treat it as a soft 404.
    //   4. Active date empty AND active === today AND nothing in the
    //      category → placeholder visible alone. Message: just "No tips
    //      for this date."
    //   5. Active date empty AND active !== today (user clicked an empty
    //      past or future date) → placeholder alone with the date they
    //      chose. No fallback content; the user's explicit pick wins.
    const MSG_DEFAULT = "No tips for this date.";
    const MSG_FUTURE = "No tips for this date. Browse upcoming fixtures below.";
    const MSG_PAST = "No tips for this date. Showing the most recent past tips below.";

    function updateSections(activeDate) {
      const today = londonTodayIso();

      document.querySelectorAll("[data-date-filter-section]").forEach((section) => {
        const isGrouped = section.dataset.dateGrouped === "true";
        const empty = section.querySelector("[data-date-empty]");
        const count = section.querySelector("[data-date-count]");

        if (isGrouped) {
          // Real date groups only (exclude the placeholder, which is matched
          // separately below).
          const groups = Array.from(
            section.querySelectorAll("[data-date-group]:not([data-date-group-placeholder])"),
          );
          const placeholder = section.querySelector("[data-date-group-placeholder]");

          // Does the active date have a real group with tips?
          const activeGroup = groups.find((g) => g.dataset.dateGroup === activeDate);
          const activeHasTips =
            !!activeGroup && activeGroup.querySelectorAll("[data-tip-date]").length > 0;
          const isToday = activeDate === today;

          // Decide which real groups (other than active) should be shown,
          // and which placeholder message variant fits.
          let revealFutureFromToday = false;
          let revealMostRecentPast = false;
          let placeholderMessage = MSG_DEFAULT;

          if (!activeHasTips && isToday) {
            const hasFuture = groups.some((g) => (g.dataset.dateGroup || "") > today);
            if (hasFuture) {
              revealFutureFromToday = true;
              placeholderMessage = MSG_FUTURE;
            } else {
              const hasPast = groups.some((g) => (g.dataset.dateGroup || "") < today);
              if (hasPast) {
                revealMostRecentPast = true;
                placeholderMessage = MSG_PAST;
              }
            }
          }

          // Identify the single most-recent past group when the past-fallback
          // mode is active. Pick the largest groupDate strictly less than today.
          let mostRecentPastDate = "";
          if (revealMostRecentPast) {
            for (const g of groups) {
              const d = g.dataset.dateGroup || "";
              if (d && d < today && d > mostRecentPastDate) {
                mostRecentPastDate = d;
              }
            }
          }

          let totalVisible = 0;
          groups.forEach((group) => {
            const groupDate = group.dataset.dateGroup || "";
            let shouldShow;
            if (activeHasTips) {
              shouldShow = groupDate === activeDate;
            } else if (revealFutureFromToday) {
              shouldShow = groupDate > today;
            } else if (revealMostRecentPast) {
              shouldShow = groupDate === mostRecentPastDate;
            } else {
              shouldShow = false;
            }
            group.hidden = !shouldShow;
            if (shouldShow) {
              totalVisible += group.querySelectorAll("[data-tip-date]").length;
            }
          });

          if (placeholder) {
            placeholder.hidden = activeHasTips;
            if (!activeHasTips) {
              placeholder.dataset.dateGroup = activeDate;
              const head = placeholder.querySelector("[data-date-group-head]");
              if (head) head.dataset.dateGroupHead = activeDate;
              const label = placeholder.querySelector("[data-placeholder-label]");
              if (label) label.textContent = formatDateHeader(activeDate);
              const message = placeholder.querySelector("[data-placeholder-message]");
              if (message) message.textContent = placeholderMessage;
            }
          }

          // The "nothing at all" empty state. Only fires when there are no
          // real tips visible AND no placeholder (e.g. a category with zero
          // posts ever published).
          if (empty) {
            const fullyEmpty = totalVisible === 0 && !placeholder;
            empty.hidden = !fullyEmpty;
          }
          setCountText(count, totalVisible);
          return;
        }

        // Flat mode (homepage hub lists, sport-hub featured lists): hide
        // individual rows that don't match the active date.
        const rows = Array.from(section.querySelectorAll("[data-tip-date]"));
        let visible = 0;
        rows.forEach((row) => {
          const matches = row.dataset.tipDate === activeDate;
          row.hidden = !matches;
          if (matches) visible += 1;
        });

        if (empty) empty.hidden = visible > 0;
        setCountText(count, visible);
      });
    }

    function initialActiveDate(preferredDate, _forcePreferred = false) {
      // Always default to the preferred date (today, or the ?date= URL param).
      // Older versions of this function fell back to "first tip date in DOM
      // order" when today had no tips, but that landed visitors on random
      // past dates and confused the date-rail active highlight. The empty
      // state in TipListSection handles no-tips-today gracefully, and the
      // "today + future stacking" logic still surfaces future dates
      // underneath today's empty header.
      return preferredDate;
    }

    function applyDate(activeDate, updateUrl = false) {
      const available = availableDates();
      updateRails(activeDate, available);
      updateSections(activeDate);

      if (updateUrl) {
        syncDateQuery(activeDate);
      }

      window.requestAnimationFrame(revealActiveDate);
    }

    document.addEventListener("click", (event) => {
      const link = event.target.closest("[data-date-link]");

      if (!link) {
        return;
      }

      event.preventDefault();

      const nextDate = link.dataset.date;

      if (!nextDate || !isoPattern.test(nextDate)) {
        return;
      }

      applyDate(nextDate, true);
    });

    const explicitDate = queryDate();
    const preferredDate = explicitDate || londonTodayIso();

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        applyDate(initialActiveDate(preferredDate, Boolean(explicitDate)));
      }, { once: true });
    } else {
      applyDate(initialActiveDate(preferredDate, Boolean(explicitDate)));
    }
  })();
</script>

<style>
  .date-rail {
    background: #08224d;
    border: 1px solid #d7dde6;
    border-radius: 8px;
    color: #fff;
    height: 68px;
    overflow: hidden;
  }

  .date-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(94px, 1fr);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .date-list::-webkit-scrollbar {
    display: none;
  }

  .date-item {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.18);
    color: #c8d7f3;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    font: inherit;
    gap: 0.2rem;
    justify-content: center;
    min-height: 68px;
    min-width: 94px;
    padding: 0.65rem 0.55rem 0.55rem;
    position: relative;
    scroll-snap-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .date-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .date-item.is-empty {
    color: #7e91b7;
    opacity: 0.45;
  }

  .date-item.is-empty:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #7e91b7;
  }

  .date-item strong {
    color: inherit;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .date-item span {
    color: #8fa6cf;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .date-item.active {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .date-item.active span {
    color: #dbe8ff;
  }

  .date-item.active::after {
    background: var(--ot-brand-orange);
    bottom: 0;
    content: "";
    height: 3px;
    left: 18%;
    position: absolute;
    right: 18%;
  }

  @media (max-width: 720px) {
    .date-rail {
      height: 62px;
    }

    .date-list {
      grid-auto-columns: minmax(82px, 1fr);
    }

    .date-item {
      min-height: 62px;
      min-width: 82px;
    }

    .date-item strong {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }
  }
</style>
