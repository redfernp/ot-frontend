---
// "Today's strongest tips" band: six cards linking to the football tips pages
// (correct score, 1X2, goals, BTTS, acca), each showing today's top pick and
// its Power Rating when the plugin's export is current. Used on the homepage
// and the football hub.
import { cmsLinkToPath } from "@/lib/cmsContent";
import { BEST_BETS_HUB, BEST_BETS_LIST_ID, isCurrent, loadStrongTips, STRONG_TIP_PAGES } from "@/lib/strongTips";

type Props = {
  heading?: string;
  eyebrow?: string;
  // "light" for pages where the band sits under another navy block (football hub).
  tone?: "dark" | "light";
  // On the Best Bets hub itself: market names as labels, 1X2 links down the page.
  hub?: boolean;
};

const { heading = "Today's Strongest Football Tips", eyebrow = "Backed by our tips model", tone = "dark", hub = false } = Astro.props;

const data = await loadStrongTips();
const current = isCurrent(data) ? data : null;

const cards = STRONG_TIP_PAGES.map((entry) => {
  const page = hub && entry.href === BEST_BETS_HUB
    ? { ...entry, label: "Match Result", href: `#${BEST_BETS_LIST_ID}` }
    : entry;
  if (!current) return { ...page, pick: null, sub: null, power: null, tipHref: null };
  if (page.market === "acca") {
    const acca = current.accas?.all;
    return {
      ...page,
      pick: acca ? `${acca.legs.length}-fold @ ${acca.combinedOdds.toFixed(2)}` : null,
      sub: acca ? "Today's acca of the day" : null,
      power: acca ? acca.power : null,
      tipHref: null,
    };
  }
  const top = current.markets?.[page.market]?.tips?.[0];
  if (!top) return { ...page, pick: null, sub: null, power: null, tipHref: null };
  const tip = page.market === "cs" ? `Correct score ${top.tip}` : top.tip;
  return {
    ...page,
    pick: top.fixture,
    sub: top.odds ? `${tip} @ ${top.odds.toFixed(2)}` : tip,
    power: top.power,
    // The fixture opens the full tip post for that match.
    tipHref: top.tipUrl ? cmsLinkToPath(top.tipUrl) || top.tipUrl : null,
  };
});

const band = (power: number) => (power >= 75 ? "high" : power >= 50 ? "mid" : "low");
---

<section class:list={["strong-band", { "strong-band--light": tone === "light" }]} aria-labelledby="strong-band-heading">
  <header class="strong-head">
    <p class="strong-eyebrow">{eyebrow}</p>
    <h2 id="strong-band-heading">{heading}</h2>
    <p class="strong-lede">Our highest-rated picks of the day, backed by xG and form data and updated every morning.</p>
  </header>

  <div class="strong-grid">
    {cards.map((card) => (
      <div class:list={["strong-card", { "is-acca": card.market === "acca" }]}>
        <a class="strong-label" href={card.href}>{card.label}</a>
        {card.pick ? (
          <>
            {card.tipHref
              ? <a class="strong-pick" href={card.tipHref}>{card.pick}</a>
              : <a class="strong-pick" href={card.href}>{card.pick}</a>}
            <span class="strong-sub">{card.sub}</span>
            {card.power !== null && (
              <span class={`strong-power strong-power--${band(card.power)}`} aria-label={`Power Rating ${card.power} out of 100`}>
                <span class="strong-power-track"><span class="strong-power-fill" style={`width:${card.power}%`}></span></span>
                <span class="strong-power-num">{card.power}</span>
              </span>
            )}
          </>
        ) : (
          <span class="strong-blurb">{card.blurb}</span>
        )}
        <a class="strong-cta" href={card.href}>See all tips <span aria-hidden="true">&rarr;</span></a>
      </div>
    ))}
  </div>
</section>

<style>
  .strong-band {
    background: linear-gradient(135deg, var(--ot-ink) 0%, var(--ot-ink-2) 100%);
    border-radius: var(--ot-radius);
    color: #fff;
    margin: 1.5rem 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .strong-head { margin-bottom: 1.1rem; }
  .strong-eyebrow {
    color: var(--ot-gold);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }
  .strong-head h2 { color: #fff; font-size: clamp(1.35rem, 2.6vw, 1.75rem); margin: 0 0 0.35rem; }
  .strong-lede { color: #cfe1f4; margin: 0; max-width: 60ch; }

  .strong-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .strong-card {
    background: var(--ot-surface);
    border-bottom: 3px solid var(--ot-gold);
    border-radius: var(--ot-radius-sm);
    color: var(--ot-text);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 9.5rem;
    padding: 1rem 1.1rem;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .strong-card:hover {
    box-shadow: var(--ot-shadow-md);
    transform: translateY(-2px);
  }
  .strong-card.is-acca { border-bottom-color: var(--ot-green); }
  .strong-label {
    color: var(--ot-brand-blue-dark);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .strong-label { text-decoration: none; }
  .strong-pick { color: var(--ot-text); font-size: 1.05rem; font-weight: 900; line-height: 1.25; text-decoration: none; }
  .strong-pick:hover { color: var(--ot-brand-blue); text-decoration: underline; }
  .strong-sub { color: var(--ot-text-2); font-size: 0.85rem; }
  .strong-blurb { color: var(--ot-text-2); font-size: 0.9rem; line-height: 1.4; }

  .strong-power { align-items: center; display: flex; gap: 0.5rem; margin-top: 0.2rem; }
  .strong-power-track { background: var(--ot-border); border-radius: 999px; flex: 1; height: 0.5rem; overflow: hidden; }
  .strong-power-fill { border-radius: 999px; display: block; height: 100%; }
  .strong-power--high .strong-power-fill { background: var(--ot-green); }
  .strong-power--mid .strong-power-fill { background: var(--ot-gold); }
  .strong-power--low .strong-power-fill { background: var(--ot-muted); }
  .strong-power-num { font-size: 0.85rem; font-variant-numeric: tabular-nums; font-weight: 900; }

  .strong-cta {
    color: var(--ot-brand-blue);
    font-size: 0.85rem;
    font-weight: 800;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .strong-cta { text-decoration: none; }
  .strong-cta:hover { color: var(--ot-brand-orange); }

  .strong-band--light {
    background: var(--ot-surface);
    border: 1px solid var(--ot-border);
    border-top: 4px solid var(--ot-gold);
    color: var(--ot-text);
  }
  .strong-band--light .strong-eyebrow { color: var(--ot-green); }
  .strong-band--light .strong-head h2 { color: var(--ot-ink); }
  .strong-band--light .strong-lede { color: var(--ot-muted); }
  .strong-band--light .strong-card {
    background: var(--ot-bg);
    border: 1px solid var(--ot-border);
    border-bottom: 3px solid var(--ot-gold);
  }
  .strong-band--light .strong-card.is-acca { border-bottom-color: var(--ot-green); }
  .strong-band--light .strong-power-track { background: #d5dde8; }
</style>
