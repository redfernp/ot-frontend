---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryTipsPage from "@/components/CategoryTipsPage.astro";
import FootballHubPage from "@/components/FootballHubPage.astro";
import GenericPage from "@/components/GenericPage.astro";
import TennisHubPage from "@/components/TennisHubPage.astro";
import TipPostPage from "@/components/TipPostPage.astro";
import { WPGRAPHQL_ENDPOINT } from "astro:env/server";
import {
  getAllCategorySlugs,
  getAllPostSlugs,
  getCategory,
  getPage,
  getPages,
  getPost,
  getRelatedPosts,
  type WpPost,
} from "@/lib/graphql";

// Static prerender every WP-backed URL at build time. Reverted from SSR
// because the 2GB Cloudways WP backend (shared with 8 other apps + Imunify360
// scans) cannot reliably serve worker queries on cache miss; every cold visit
// would push WP into PHP-FPM exhaustion. Building all pages once per deploy
// hits WP ~2000 times in a controlled sequence, then visitors hit pure static
// HTML afterwards with no upstream load.
//
// Trade-off: new tips published between builds aren't visible until the next
// build. With an hourly external cron triggering CF Pages rebuilds, freshness
// is "within the last hour" rather than "within the last 5 min". Acceptable
// given the alternative is the site being intermittently down.
export const prerender = true;

const simpleSportHubSlugs = new Set(["tennis", "cricket", "snooker", "darts", "basketball"]);

type RouteKind = "category" | "post" | "page";
type RouteProps = {
  kind: RouteKind;
  slug?: string;
  uri?: string;
};

export async function getStaticPaths() {
  // Fetch all enumerable WP URLs in parallel. Each helper paginates internally
  // and is intentionally slug/uri-only to keep the WP load light during this
  // phase. Heavier per-page queries happen below when each individual page
  // renders.
  // Limits set high enough to cover the full snapshot. Previous build-time
  // ceiling (100/100) existed because each page render fired its own
  // WPGraphQL query and we needed to stay under the 20min CF Pages build
  // budget. Snapshot mode renders every page from in-memory data, so a
  // build covering all ~2300 categories + ~1600 posts completes in 5-10 min.
  const [categories, posts, pages] = await Promise.all([
    getAllCategorySlugs(5000).catch(() => []),
    getAllPostSlugs(5000).catch(() => []),
    getPages(500).catch(() => []),
  ]);

  const seen = new Set<string>();
  const paths: Array<{ params: { path: string }; props: RouteProps }> = [];

  function add(path: string | undefined | null, props: RouteProps) {
    if (!path) return;
    const cleaned = path.replace(/^\/+|\/+$/g, "");
    if (!cleaned) return;
    if (seen.has(cleaned)) return;
    seen.add(cleaned);
    paths.push({ params: { path: cleaned }, props });
  }

  // Top-level sport hubs are always built, even if the WP category has no
  // direct posts. Category paths below are filtered to entries that can render
  // at least one tip row, so hardcoding these hubs guarantees the critical
  // sport landing URLs are always built.
  ["football", "tennis", "cricket", "basketball", "darts", "snooker"].forEach((slug) => {
    add(slug, { kind: "category", slug });
  });

  // Categories preserve their full WP uri (e.g. football/united-kingdom/england-premier-league).
  categories.forEach((cat) => add(cat.uri, { kind: "category", slug: cat.slug, uri: cat.uri }));

  // Posts are flat single-segment slugs.
  posts.forEach((post) => add(post.slug, { kind: "post", slug: post.slug, uri: post.uri }));

  // Pages use their full uri, but skip ones already handled elsewhere (e.g. /).
  pages.forEach((page) => add(page.uri, { kind: "page", slug: page.slug, uri: page.uri }));

  return paths;
}

// Path resolver, per-page render. Runs at build time for every path returned
// from getStaticPaths above.
const rawPath = (Astro.params.path || "").replace(/^\/+|\/+$/g, "");
const segments = rawPath.split("/").filter(Boolean);

const firstSegment = segments[0] ?? "";
const lastSegment = segments[segments.length - 1] ?? "";
const route = Astro.props as RouteProps | undefined;
const looksLikeCategory =
  segments.length >= 2 || firstSegment === "football" || simpleSportHubSlugs.has(firstSegment);

let category = null;
let post: WpPost | null = null;
let page: WpPost | null = null;
let relatedPosts: WpPost[] = [];
let categorySlug = "";

if (route?.kind === "category" || (!route && looksLikeCategory)) {
  categorySlug = route?.slug || lastSegment;
  // Pull every post in the category, not just the most recently published
  // 15. The 15-limit was cutting off today/this-week fixtures whenever the
  // paul365 cron published a batch for later dates more recently. Date
  // grouping + DateRail filter happens client-side, so a high cap is fine.
  // The snapshot only ever has ~1600 total posts so even the busiest
  // category stays well under this ceiling.
  category = await getCategory(categorySlug, 1000).catch(() => null);
} else if (route?.kind === "post") {
  const slug = route.slug || firstSegment;
  post = await getPost(slug).catch(() => null);
  if (post) {
    relatedPosts = await getRelatedPosts(post).catch(() => []);
  }
} else if (route?.kind === "page") {
  const pageUri = route.uri || `/${rawPath}/`;
  page = await getPage(pageUri).catch(() => null);
} else {
  const slug = firstSegment;
  const pageUri = `/${slug}/`;

  const [postResult, pageResult] = await Promise.all([
    getPost(slug).catch(() => null),
    getPage(pageUri).catch(() => null),
  ]);

  if (postResult) {
    post = postResult;
    relatedPosts = await getRelatedPosts(post).catch(() => []);
  } else if (pageResult) {
    page = pageResult;
  }
}

const unresolved = !page && !post && !category;

// In static output an unresolved generated route becomes a real HTML file and
// Cloudflare serves it as HTTP 200, which is a soft 404. If WP is configured,
// fail the build so the previous healthy deploy stays live instead of shipping
// bad crawlable pages.
if (unresolved && WPGRAPHQL_ENDPOINT) {
  throw new Error(
    `[...path] Static path "${rawPath}" was emitted as ${route?.kind ?? "unknown"} but did not resolve. ` +
      "Refusing to generate a 200 soft-404 page.",
  );
}
---

<BaseLayout
  title={unresolved ? "Page not found | Oddstips" : page?.title || post?.title || `${category?.name || "Category"} Betting Tips`}
  description={unresolved ? "The page you requested isn't here. Browse our latest betting tips by sport instead." : page?.seo?.metaDesc || post?.excerpt || category?.description || ""}
  seo={page?.seo || post?.seo || category?.seo}
  noindex={unresolved}
>
  {page ? (
    <GenericPage page={page} />
  ) : post ? (
    <TipPostPage post={post} relatedPosts={relatedPosts} />
  ) : category && categorySlug === "football" ? (
    <FootballHubPage category={category} />
  ) : category && simpleSportHubSlugs.has(categorySlug) ? (
    <TennisHubPage category={category} />
  ) : category ? (
    <CategoryTipsPage category={category} />
  ) : (
    <div style="max-width:680px;margin:6rem auto;padding:2rem;text-align:center;">
      <h1 style="font-size:2rem;margin-bottom:1rem;">Page not available</h1>
      <p>This tip may have been removed or rescheduled. Browse our <a href="/football/">latest football tips</a> or visit the <a href="/">homepage</a> for today's top picks.</p>
    </div>
  )}
</BaseLayout>
