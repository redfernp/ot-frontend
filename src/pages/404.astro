---
// CF Pages serves this file's output (dist/404.html) as the response body for
// any unmatched route. Without it, CF Pages falls back to dist/index.html and
// Google ends up canonicalising every typo / dropped-page / legacy-slug URL
// to the homepage, because the response body it sees IS the homepage HTML.
//
// We pass noindex so the 404 itself never appears in search results, and we
// pass a self-referencing canonical to keep the canonical signal clean for
// the few edge cases where Google does crawl this page directly.
//
// Astro static-build output: dist/404.html. CF Pages auto-detects and serves
// it with HTTP 404 for any path that doesn't match a generated route.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Oddstips" description="The page you requested isn't here. Browse our latest betting tips by sport instead." noindex>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist</h1>
    <p class="lede">The link you followed has moved or the page no longer exists. Try one of the most popular sections instead.</p>
    <div class="links">
      <a href="/">Home</a>
      <a href="/football/">Football tips</a>
      <a href="/football/international/world-cup/">World Cup tips</a>
      <a href="/tennis/">Tennis tips</a>
      <a href="/cricket/">Cricket tips</a>
      <a href="/free-bets/">Free bets</a>
      <a href="/reviews/">Bookmaker reviews</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background: var(--ot-surface);
    border: 1px solid var(--ot-border);
    border-radius: var(--ot-radius);
    box-shadow: var(--ot-shadow-sm);
    margin: 2rem auto;
    max-width: 640px;
    padding: 2.5rem 2rem;
    text-align: center;
  }
  .eyebrow {
    color: var(--ot-brand-orange);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    margin: 0;
    text-transform: uppercase;
  }
  h1 {
    color: var(--ot-text);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0.5rem 0 0.75rem;
  }
  .lede {
    color: var(--ot-muted);
    font-size: 1rem;
    margin: 0 auto 1.5rem;
    max-width: 48ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .links a {
    background: var(--ot-surface-2);
    border: 1px solid var(--ot-border);
    border-radius: 999px;
    color: var(--ot-brand-blue);
    display: inline-block;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.45rem 0.95rem;
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }
  .links a:hover {
    background: var(--ot-brand-blue);
    color: #fff;
  }
</style>
